# Copy to .env for local `netlify dev`. Real values are never committed - .env is gitignored.
# In production these are set in the Netlify dashboard (Site configuration -> Environment
# variables), never in this file or in netlify.toml.

# Required for account signup/login/logout/session (netlify/functions/auth-*.mjs).
# Signs the session cookie. Generate one with: openssl rand -base64 32
PLANONIT_SESSION_SECRET=

# Optional. Only needed if you opt into the server-authoritative reservation transaction
# (netlify/functions/reserve.mjs, src/authority.ts) via VITE_PLANONIT_AUTHORITY_ENDPOINT.
# Not required for accounts and not enabled in production by default.
PLANONIT_WORKSPACE_TOKEN=
